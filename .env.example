# 
ENV='DEVEPS'
# Puertos personalizados
APP_PORT=8080          # Puerto para la aplicación CodeIgniter
DB_PORT=3307           # Puerto para MySQL (diferente al default 3306)
PMA_PORT=8081          # Puerto para phpMyAdmin

# Configuración MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sistema_dev
MYSQL_USER=devcash
MYSQL_PASSWORD=1234

# Límite de subida para phpMyAdmin
UPLOAD_LIMIT=500M
# SESS_SAVE_PATH=FCPATH . 'application/cache/sessions/'
SESS_SAVE_PATH='cache/sessions/'


# Docker
# DB configuration
APP_URL="http://localhost:9090"
DB_HOSTNAME="ci3_db"
DB_USERNAME="devcash"
DB_PASSWORD="1234"
DB_DATABASE="sistema_app"
DB_DRIVER="mysqli"


